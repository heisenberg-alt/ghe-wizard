# Normalize line endings: keep source as LF in the repo.
* text=auto eol=lf

*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Binary assets should never be normalized.
*.png binary
*.gif binary
*.ico binary
*.woff2 binary
